# Envanter örneği. Docker için cms:setup ile özel .env.cms.* dosyalarını oluşturun.
# Proje tamamlanıp yayınlanırken SITE_URL=https://gunayturan.com.tr kullanılır.
SITE_URL=http://localhost:3000

# npm start öncesi production değeri build/runtime ortamında açıkça ayarlanmalı.
# CMS runtime için PAYLOAD_SECRET ve DATABASE_URI zorunludur.
# PAYLOAD_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# DATABASE_URI=postgresql://example_user:CHANGE_ME@example.invalid:5432/example_db
# CMS_ADMIN_EMAIL=admin@example.invalid
# CMS_ADMIN_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
# POSTGRES_USER=diyet
# POSTGRES_DB=diyet
# POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
# Sağlayıcıya özel e-posta/storage/analytics değişkenleri henüz seçilmedi.
